import os
from flask import Flask, request, jsonify
from langchain_community.document_loaders import TextLoader
from langchain_text_splitters import RecursiveCharacterTextSplitter
from langchain_openai import OpenAIEmbeddings, ChatOpenAI
from langchain_community.vectorstores import Chroma
from langchain_core.prompts import ChatPromptTemplate
from langchain_core.output_parsers import StrOutputParser
from langchain_core.runnables import RunnablePassthrough

app = Flask(__name__)

# Global variables for RAG pipeline components
retriever = None
rag_chain = None

def initialize_rag_pipeline(data_path="knowledge_base.txt"):
    """
    Sets up the RAG pipeline:
    1. Loads domain text document.
    2. Chunks raw text into overlapping windows.
    3. Generates vector embeddings and stores them in ChromaDB.
    4. Builds the RAG execution chain with prompt engineering.
    """
    global retriever, rag_chain

    # 1. Document Loading & Preprocessing
    if not os.path.exists(data_path):
        # Create a sample knowledge base file if it doesn't exist
        with open(data_path, "w") as f:
            f.write(
                "Company Policy Update 2026:\n"
                "Employees can claim up to $500 annually for wellness and learning activities. "
                "Remote work choices must be logged in the HR portal by the 15th of every month. "
                "For technical support, submit a ticket via the IT help desk portal."
            )

    loader = TextLoader(data_path)
    docs = loader.load()

    # Optimized Chunking Strategy (chunk_size=500, overlap=50 for context preservation)
    text_splitter = RecursiveCharacterTextSplitter(
        chunk_size=500,
        chunk_overlap=50,
        length_function=len
    )
    chunks = text_splitter.split_documents(docs)

    # 2. Embeddings & Vector Store Initialization
    embeddings = OpenAIEmbeddings()
    vectorstore = Chroma.from_documents(
        documents=chunks,
        embedding=embeddings,
        collection_name="company_docs"
    )

    # Retrieval Pipeline (Top-k similarity search)
    retriever = vectorstore.as_retriever(search_kwargs={"k": 3})

    # 3. Prompt Engineering & Generation Model Setup
    llm = ChatOpenAI(model="gpt-3.5-turbo", temperature=0)

    prompt_template = """
    You are a context-aware AI assistant. Answer the user's question accurately using ONLY 
    the provided context below. If the context does not contain enough information to answer, 
    state 'I do not have enough information in the domain documents to answer that.'

    Context:
    {context}

    Question: 
    {question}

    Answer:
    """
    prompt = ChatPromptTemplate.from_template(prompt_template)

    # Format retrieved documents into a single text block
    def format_docs(docs):
        return "\n\n".join(doc.page_content for doc in docs)

    # LangChain Runnable Chain
    rag_chain = (
        {"context": retriever | format_docs, "question": RunnablePassthrough()}
        | prompt
        | llm
        | StrOutputParser()
    )


# --- API Routes ---

@app.route("/health", methods=["GET"])
def health_check():
    """Endpoint to check API service status."""
    return jsonify({"status": "healthy", "service": "RAG-Assistant-API"}), 200


@app.route("/api/query", methods=["POST"])
def query_rag():
    """
    Primary API endpoint to handle conversational requests.
    Expects JSON input: {"question": "Your text here"}
    """
    data = request.get_json()

    if not data or "question" not in data:
        return jsonify({"error": "Missing 'question' parameter in request body."}), 400

    user_question = data["question"]

    try:
        # Retrieve relevant context snippets
        retrieved_docs = retriever.invoke(user_question)
        source_contexts = [doc.page_content for doc in retrieved_docs]

        # Generate response using LLM
        response_text = rag_chain.invoke(user_question)

        return jsonify({
            "question": user_question,
            "answer": response_text,
            "retrieved_sources": source_contexts
        }), 200

    except Exception as e:
        return jsonify({"error": "Failed to process query", "details": str(e)}), 500


if __name__ == "__main__":
    # Initialize RAG Pipeline before starting server
    initialize_rag_pipeline()
    app.run(host="0.0.0.0", port=5000, debug=True)
